# Required production services
DATABASE_URL=postgresql://USER:PASSWORD@HOST/DB?sslmode=require
AI_GATEWAY_API_KEY=

# Ordered Vercel AI Gateway fallbacks. The next model is tried if one fails.
EDITORIAL_MODELS=openai/gpt-5.4-mini,google/gemini-3.5-flash
WRITER_MODELS=openai/gpt-5.4-mini,anthropic/claude-sonnet-5
VERIFIER_MODELS=google/gemini-3.5-flash,openai/gpt-5.4-mini
EMBEDDING_MODELS=openai/text-embedding-3-small

# Optional source access
GITHUB_TOKEN=
EXTRA_RSS_FEEDS=
EXTRA_GITHUB_REPOS=

# Autonomous timing. Defaults cover the full 48-hour evaluation without ending early.
FIRST_CYCLE_DELAY_SECONDS=45
MIN_CYCLE_DELAY_SECONDS=5400
MAX_CYCLE_DELAY_SECONDS=10800
MAX_AUTONOMOUS_CYCLES=36
EVALUATION_WINDOW_HOURS=50
MIN_POST_SPACING_MINUTES=135
MAX_POSTS_PER_DAY=6

# Editorial and evidence quality gates
MAX_DISCOVERED_ITEMS=80
MAX_EDITORIAL_CANDIDATES=12
MIN_PUBLICATION_SCORE=72
MIN_QUALITY_GATE_SCORE=80
SEMANTIC_DUPLICATE_THRESHOLD=0.86
SOURCE_FETCH_CONCURRENCY=6

# Safe continuity mode. Keep true for demos; set false if every publication must require AI.
ALLOW_DEMO_FALLBACK=true

# Optional operational endpoint protection
ADMIN_API_KEY=
